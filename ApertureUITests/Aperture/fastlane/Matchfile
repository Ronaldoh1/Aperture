# ═══════════════════════════════════════════════════════════════════════════════
# APERTURE - Match Configuration (Code Signing)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Match syncs your certificates and provisioning profiles across your team
# using a private Git repository.
#
# Setup:
#   1. Create a private GitHub repo (e.g., github.com/yourusername/certificates)
#   2. Run: fastlane match init
#   3. Run: fastlane match development
#   4. Run: fastlane match adhoc
#   5. Run: fastlane match appstore
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# GIT REPOSITORY
# ─────────────────────────────────────────────────────────────────────────────────
# URL to the git repo containing your certificates
# IMPORTANT: This should be a PRIVATE repository!

git_url(ENV["MATCH_GIT_URL"] || "https://github.com/yourusername/ios-certificates.git")

# ─────────────────────────────────────────────────────────────────────────────────
# STORAGE MODE
# ─────────────────────────────────────────────────────────────────────────────────
# Options: git, google_cloud, s3
# git is simplest for small teams

storage_mode("git")

# ─────────────────────────────────────────────────────────────────────────────────
# APP IDENTIFIER
# ─────────────────────────────────────────────────────────────────────────────────

app_identifier(["com.sunflow.aperture"])

# ─────────────────────────────────────────────────────────────────────────────────
# CREDENTIALS
# ─────────────────────────────────────────────────────────────────────────────────

username(ENV["APPLE_ID"] || "your-apple-id@email.com")
team_id(ENV["TEAM_ID"] || "XXXXXXXXXX")

# ─────────────────────────────────────────────────────────────────────────────────
# OPTIONS
# ─────────────────────────────────────────────────────────────────────────────────

# Certificate types to manage
type("development") # Can be: development, adhoc, appstore, enterprise

# Clone using SSH vs HTTPS
# clone_branch_directly(true)

# Keychain for CI
# keychain_name(ENV["MATCH_KEYCHAIN_NAME"] || "login.keychain")
# keychain_password(ENV["MATCH_KEYCHAIN_PASSWORD"])

# For CI environments, set readonly to avoid accidental changes
readonly(is_ci)

# Verbose output for debugging
# verbose(true)
