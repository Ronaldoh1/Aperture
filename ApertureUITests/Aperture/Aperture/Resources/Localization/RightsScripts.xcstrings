    "rights.ice.administrative" : {
      "comment" : "ICE warrant types - Administrative",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمر إداري من ICE - لا يسمح بدخول المنزل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ICE ADMINISTRATIVE WARRANT - Does NOT authorize home entry"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ORDEN ADMINISTRATIVA DE ICE - NO autoriza entrada al hogar"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ICE ADMINISTRATIBONG WARRANT - HINDI pinapayagan ang pagpasok sa bahay"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MANDAT ADMINISTRATIF ICE - N'autorise PAS l'entrée au domicile"
