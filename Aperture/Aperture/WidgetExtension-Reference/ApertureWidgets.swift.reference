// ApertureWidgets.swift
// Widget views for Home Screen and Lock Screen
// Note: Requires a Widget Extension target to be added to the project

import SwiftUI
import WidgetKit

// MARK: - Widget Entry

struct ApertureWidgetEntry: TimelineEntry {
    let date: Date
    let progressData: ProgressData
    let dragonData: DragonData
    let wisdomQuote: String
    
    struct ProgressData {
        let completedCourses: Int
        let totalCourses: Int
        let completedLessons: Int
        let currentStreak: Int
    }
    
    struct DragonData {
        let stage: Int
        let xp: Int
        let maxXP: Int
        let stageName: String
    }
    
    static var placeholder: ApertureWidgetEntry {
        ApertureWidgetEntry(
            date: Date(),
            progressData: ProgressData(completedCourses: 3, totalCourses: 20, completedLessons: 15, currentStreak: 7),
            dragonData: DragonData(stage: 2, xp: 450, maxXP: 1000, stageName: "Youth"),
            wisdomQuote: "The observer affects the observed."
        )
    }
}

// MARK: - Small Widget (Progress Ring)

struct SmallProgressWidget: View {
    
    let entry: ApertureWidgetEntry
    
    var progress: Double {
        Double(entry.progressData.completedLessons) / max(Double(entry.progressData.totalCourses * 5), 1)
    }
    
    var body: some View {
        ZStack {
            // Background
            LinearGradient(
                colors: [Color.black, Color.purple.opacity(0.3)],
                startPoint: .topLeading,
                endPoint: .bottomTrailing
            )
            
            VStack(spacing: 8) {
                // Progress ring
                ZStack {
                    Circle()
                        .stroke(Color.white.opacity(0.2), lineWidth: 8)
                    
                    Circle()
                        .trim(from: 0, to: progress)
                        .stroke(
                            LinearGradient(colors: [.orange, .yellow], startPoint: .leading, endPoint: .trailing),
                            style: StrokeStyle(lineWidth: 8, lineCap: .round)
                        )
                        .rotationEffect(.degrees(-90))
                    
                    VStack(spacing: 0) {
                        Text("\(entry.progressData.completedLessons)")
                            .font(.system(size: 24, weight: .bold, design: .rounded))
                            .foregroundColor(.white)
                        Text("lessons")
                            .font(.system(size: 10, weight: .medium))
                            .foregroundColor(.white.opacity(0.7))
                    }
                }
                .frame(width: 80, height: 80)
                
                // Streak
                HStack(spacing: 4) {
                    Image(systemName: "flame.fill")
                        .foregroundColor(.orange)
                    Text("\(entry.progressData.currentStreak) day streak")
                        .font(.system(size: 10, weight: .medium, design: .rounded))
                        .foregroundColor(.white.opacity(0.8))
                }
            }
            .padding()
        }
    }
}

// MARK: - Medium Widget (Dragon + Progress)

struct MediumDragonWidget: View {
    
    let entry: ApertureWidgetEntry
    
    var dragonProgress: Double {
        Double(entry.dragonData.xp) / Double(entry.dragonData.maxXP)
    }
    
    var body: some View {
        ZStack {
            // Background
            LinearGradient(
                colors: [Color.black, Color.orange.opacity(0.2), Color.black],
                startPoint: .leading,
                endPoint: .trailing
            )
            
            HStack(spacing: 16) {
                // Dragon
                VStack(spacing: 8) {
                    Image(systemName: "flame.fill")
                        .font(.system(size: 40))
                        .foregroundStyle(
                            LinearGradient(
                                colors: [.orange, .yellow, .red],
                                startPoint: .top,
                                endPoint: .bottom
                            )
                        )
                    
                    Text(entry.dragonData.stageName)
                        .font(.system(size: 12, weight: .bold, design: .rounded))
                        .foregroundColor(.white)
                    
                    // XP Progress
                    GeometryReader { geo in
                        ZStack(alignment: .leading) {
                            Capsule()
                                .fill(Color.white.opacity(0.2))
                            
                            Capsule()
                                .fill(LinearGradient(
                                    colors: [.orange, .yellow],
                                    startPoint: .leading,
                                    endPoint: .trailing
                                ))
                                .frame(width: geo.size.width * dragonProgress)
                        }
                    }
                    .frame(height: 6)
                    .padding(.horizontal, 8)
                    
                    Text("\(entry.dragonData.xp)/\(entry.dragonData.maxXP) XP")
                        .font(.system(size: 9, weight: .medium))
                        .foregroundColor(.white.opacity(0.6))
                }
                .frame(width: 100)
                
                // Divider
                Rectangle()
                    .fill(Color.white.opacity(0.1))
                    .frame(width: 1)
                    .padding(.vertical, 16)
                
                // Stats
                VStack(alignment: .leading, spacing: 12) {
                    StatRow(icon: "book.fill", value: "\(entry.progressData.completedCourses)", label: "Courses")
                    StatRow(icon: "checkmark.circle.fill", value: "\(entry.progressData.completedLessons)", label: "Lessons")
                    StatRow(icon: "flame.fill", value: "\(entry.progressData.currentStreak)", label: "Day Streak")
                }
                
                Spacer()
            }
            .padding()
        }
    }
}

struct StatRow: View {
    let icon: String
    let value: String
    let label: String
    
    var body: some View {
        HStack(spacing: 8) {
            Image(systemName: icon)
                .font(.system(size: 14))
                .foregroundColor(.orange)
                .frame(width: 20)
            
            Text(value)
                .font(.system(size: 16, weight: .bold, design: .rounded))
                .foregroundColor(.white)
            
            Text(label)
                .font(.system(size: 12, weight: .medium))
                .foregroundColor(.white.opacity(0.6))
        }
    }
}

// MARK: - Large Widget (Wisdom + Progress)

struct LargeWisdomWidget: View {
    
    let entry: ApertureWidgetEntry
    
    var body: some View {
        ZStack {
            // Background
            LinearGradient(
                colors: [Color.black, Color.purple.opacity(0.2), Color.black],
                startPoint: .top,
                endPoint: .bottom
            )
            
            VStack(spacing: 16) {
                // Header
                HStack {
                    Image(systemName: "sun.max.fill")
                        .font(.system(size: 24))
                        .foregroundStyle(
                            LinearGradient(colors: [.orange, .yellow], startPoint: .top, endPoint: .bottom)
                        )
                    
                    Text("APERTURE")
                        .font(.system(size: 14, weight: .bold, design: .rounded))
                        .tracking(2)
                        .foregroundColor(.white.opacity(0.8))
                    
                    Spacer()
                    
                    // Streak badge
                    HStack(spacing: 4) {
                        Image(systemName: "flame.fill")
                            .foregroundColor(.orange)
                        Text("\(entry.progressData.currentStreak)")
                            .font(.system(size: 14, weight: .bold))
                            .foregroundColor(.white)
                    }
                    .padding(.horizontal, 10)
                    .padding(.vertical, 4)
                    .background(Color.white.opacity(0.1))
                    .clipShape(Capsule())
                }
                
                Divider()
                    .background(Color.white.opacity(0.1))
                
                // Wisdom quote
                VStack(spacing: 8) {
                    Image(systemName: "quote.opening")
                        .font(.system(size: 20))
                        .foregroundColor(.orange.opacity(0.6))
                    
                    Text(entry.wisdomQuote)
                        .font(.system(size: 16, weight: .medium, design: .serif))
                        .foregroundColor(.white)
                        .multilineTextAlignment(.center)
                        .lineLimit(3)
                        .padding(.horizontal)
                }
                .frame(maxWidth: .infinity)
                .padding(.vertical, 12)
                .background(Color.white.opacity(0.05))
                .clipShape(RoundedRectangle(cornerRadius: 12))
                
                Spacer()
                
                // Progress stats
                HStack(spacing: 20) {
                    ProgressStat(
                        value: entry.progressData.completedCourses,
                        total: entry.progressData.totalCourses,
                        label: "Courses",
                        color: .purple
                    )
                    
                    ProgressStat(
                        value: entry.progressData.completedLessons,
                        total: entry.progressData.totalCourses * 5,
                        label: "Lessons",
                        color: .blue
                    )
                    
                    // Dragon progress
                    VStack(spacing: 4) {
                        ZStack {
                            Circle()
                                .stroke(Color.orange.opacity(0.3), lineWidth: 4)
                                .frame(width: 50, height: 50)
                            
                            Circle()
                                .trim(from: 0, to: Double(entry.dragonData.xp) / Double(entry.dragonData.maxXP))
                                .stroke(Color.orange, style: StrokeStyle(lineWidth: 4, lineCap: .round))
                                .frame(width: 50, height: 50)
                                .rotationEffect(.degrees(-90))
                            
                            Image(systemName: "flame.fill")
                                .font(.system(size: 16))
                                .foregroundColor(.orange)
                        }
                        
                        Text(entry.dragonData.stageName)
                            .font(.system(size: 10, weight: .medium))
                            .foregroundColor(.white.opacity(0.7))
                    }
                }
            }
            .padding()
        }
    }
}

struct ProgressStat: View {
    let value: Int
    let total: Int
    let label: String
    let color: Color
    
    var progress: Double {
        Double(value) / max(Double(total), 1)
    }
    
    var body: some View {
        VStack(spacing: 4) {
            ZStack {
                Circle()
                    .stroke(color.opacity(0.3), lineWidth: 4)
                    .frame(width: 50, height: 50)
                
                Circle()
                    .trim(from: 0, to: progress)
                    .stroke(color, style: StrokeStyle(lineWidth: 4, lineCap: .round))
                    .frame(width: 50, height: 50)
                    .rotationEffect(.degrees(-90))
                
                Text("\(value)")
                    .font(.system(size: 14, weight: .bold))
                    .foregroundColor(.white)
            }
            
            Text(label)
                .font(.system(size: 10, weight: .medium))
                .foregroundColor(.white.opacity(0.7))
        }
    }
}

// MARK: - Lock Screen Widget (iOS 16+)

@available(iOS 16.0, *)
struct LockScreenProgressWidget: View {
    
    let entry: ApertureWidgetEntry
    
    var body: some View {
        Gauge(value: Double(entry.progressData.completedLessons), in: 0...100) {
            Image(systemName: "sun.max.fill")
        } currentValueLabel: {
            Text("\(entry.progressData.completedLessons)")
                .font(.system(size: 12, weight: .bold))
        }
        .gaugeStyle(.accessoryCircular)
    }
}

@available(iOS 16.0, *)
struct LockScreenStreakWidget: View {
    
    let entry: ApertureWidgetEntry
    
    var body: some View {
        HStack(spacing: 4) {
            Image(systemName: "flame.fill")
            Text("\(entry.progressData.currentStreak)")
                .font(.system(size: 14, weight: .bold))
        }
    }
}

// MARK: - Widget Configuration

/*
 
 To add widgets to Aperture:
 
 1. Add a Widget Extension target:
    File → New → Target → Widget Extension
    Name it "ApertureWidget"
 
 2. In the widget extension, create:
 
    @main
    struct ApertureWidgets: WidgetBundle {
        var body: some Widget {
            ApertureProgressWidget()
            ApertureDragonWidget()
            ApertureWisdomWidget()
        }
    }
    
    struct ApertureProgressWidget: Widget {
        var body: some WidgetConfiguration {
            StaticConfiguration(kind: "progress", provider: ApertureTimelineProvider()) { entry in
                SmallProgressWidget(entry: entry)
            }
            .configurationDisplayName("Progress")
            .description("Track your awakening progress")
            .supportedFamilies([.systemSmall])
        }
    }
 
 3. Create a TimelineProvider:
 
    struct ApertureTimelineProvider: TimelineProvider {
        func placeholder(in context: Context) -> ApertureWidgetEntry {
            .placeholder
        }
        
        func getSnapshot(in context: Context, completion: @escaping (ApertureWidgetEntry) -> Void) {
            completion(.placeholder)
        }
        
        func getTimeline(in context: Context, completion: @escaping (Timeline<ApertureWidgetEntry>) -> Void) {
            // Load real data from App Group shared container
            let entry = loadEntryFromSharedData()
            let timeline = Timeline(entries: [entry], policy: .after(Date().addingTimeInterval(3600)))
            completion(timeline)
        }
    }
 
 4. Set up App Group for data sharing:
    - Add "App Groups" capability to both app and widget
    - Use UserDefaults(suiteName: "group.com.sunflow.aperture")
 
 */

// MARK: - Shared Data Manager (for Widget)

struct WidgetDataManager {
    
    static let appGroupID = "group.com.sunflow.aperture"
    
    static var sharedDefaults: UserDefaults? {
        UserDefaults(suiteName: appGroupID)
    }
    
    // Save data for widget
    static func updateWidgetData(
        completedCourses: Int,
        totalCourses: Int,
        completedLessons: Int,
        currentStreak: Int,
        dragonStage: Int,
        dragonXP: Int,
        dragonMaxXP: Int
    ) {
        guard let defaults = sharedDefaults else { return }
        
        defaults.set(completedCourses, forKey: "widget_completed_courses")
        defaults.set(totalCourses, forKey: "widget_total_courses")
        defaults.set(completedLessons, forKey: "widget_completed_lessons")
        defaults.set(currentStreak, forKey: "widget_current_streak")
        defaults.set(dragonStage, forKey: "widget_dragon_stage")
        defaults.set(dragonXP, forKey: "widget_dragon_xp")
        defaults.set(dragonMaxXP, forKey: "widget_dragon_max_xp")
        
        // Trigger widget refresh
        WidgetCenter.shared.reloadAllTimelines()
    }
    
    // Load data for widget
    static func loadWidgetData() -> ApertureWidgetEntry {
        guard let defaults = sharedDefaults else {
            return .placeholder
        }
        
        let wisdoms = [
            "The observer affects the observed.",
            "Your dragon grows as you grow.",
            "Question everything.",
            "Awakening is unlearning lies.",
            "Sacred geometry is everywhere."
        ]
        
        return ApertureWidgetEntry(
            date: Date(),
            progressData: ApertureWidgetEntry.ProgressData(
                completedCourses: defaults.integer(forKey: "widget_completed_courses"),
                totalCourses: max(defaults.integer(forKey: "widget_total_courses"), 1),
                completedLessons: defaults.integer(forKey: "widget_completed_lessons"),
                currentStreak: defaults.integer(forKey: "widget_current_streak")
            ),
            dragonData: ApertureWidgetEntry.DragonData(
                stage: defaults.integer(forKey: "widget_dragon_stage"),
                xp: defaults.integer(forKey: "widget_dragon_xp"),
                maxXP: max(defaults.integer(forKey: "widget_dragon_max_xp"), 1),
                stageName: dragonStageName(for: defaults.integer(forKey: "widget_dragon_stage"))
            ),
            wisdomQuote: wisdoms.randomElement() ?? wisdoms[0]
        )
    }
    
    private static func dragonStageName(for stage: Int) -> String {
        let names = ["Egg", "Hatchling", "Youth", "Adult", "Elder", "Ascended"]
        return stage < names.count ? names[stage] : "Unknown"
    }
}
