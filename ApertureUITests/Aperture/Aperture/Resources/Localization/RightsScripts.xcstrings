          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi không muốn ký bất kỳ tài liệu nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我不想签署任何文件。"
          }
        }
      }
    },
    "rights.script.silence" : {
      "comment" : "CRITICAL - Right to remain silent",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أستند إلى حقي في التعديل الخامس بالتزام الصمت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I invoke my Fifth Amendment right to remain silent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invoco mi derecho de la Quinta Enmienda a permanecer en silencio."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ko ang aking karapatan sa Ikalimang Susog na manatiling tahimik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'invoque mon droit du Cinquième Amendement à garder le silence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं पांचवें संशोधन के तहत चुप रहने के अपने अधिकार का उपयोग करता हूं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwen envoke dwa Senkyèm Amandman mwen pou rete an silans."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 수정헌법 제5조에 따른 묵비권을 행사합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu invoco meu direito da Quinta Emenda de permanecer em silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ссылаюсь на свое право хранить молчание согласно Пятой поправке."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi viện dẫn quyền giữ im lặng theo Tu chính án thứ Năm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我援引第五修正案保持沉默的权利。"
          }
        }
      }
    },
    "rights.script.warrant" : {
      "comment" : "CRITICAL - Request judicial warrant",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من فضلك أرني أمراً قضائياً موقعاً من قاضٍ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please show me a warrant signed by a judge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor muéstreme una orden firmada por un juez."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakipakita sa akin ang warrant na nilagdaan ng hukom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez me montrer un mandat signé par un juge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कृपया मुझे एक न्यायाधीश द्वारा हस्ताक्षरित वारंट दिखाएं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpri montre m yon manda siyen pa yon jij."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "판사가 서명한 영장을 보여주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, mostre-me um mandado assinado por um juiz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, покажите мне ордер, подписанный судьей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui lòng cho tôi xem lệnh có chữ ký của thẩm phán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请出示由法官签署的搜查令。"
          }
        }
      }
    },
    "rights.warning.nolie" : {
      "comment" : "WARNING - Never claim citizenship falsely",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تدعي أبداً أنك مواطن إذا لم تكن كذلك - هذا جريمة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEVER claim to be a citizen if you are not - it is a crime"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NUNCA digas que eres ciudadano si no lo eres - es un delito"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HUWAG kailanman sabihing ikaw ay mamamayan kung hindi ka - ito ay krimen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prétendez JAMAIS être citoyen si vous ne l'êtes pas - c'est un crime"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप नागरिक नहीं हैं तो कभी नागरिक होने का दावा न करें - यह अपराध है"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PA JANM di ou se yon sitwayen si ou pa ye - sa se yon krim"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시민권자가 아닌데 시민권자라고 절대 주장하지 마세요 - 범죄입니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NUNCA diga que é cidadão se não for - é crime"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "НИКОГДА не заявляйте, что вы гражданин, если это не так - это преступление"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KHÔNG BAO GIỜ nói bạn là công dân nếu không phải - đó là tội phạm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您不是公民，绝不要声称是公民 - 这是犯罪"
          }
        }
      }
    },
    "rights.warning.nosign" : {
      "comment" : "WARNING - Never sign voluntary departure",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توقع أبداً على المغادرة الطوعية - ستفقد حقك في جلسات الاستماع"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEVER sign voluntary departure - you lose your right to hearings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NUNCA firmes salida voluntaria - pierdes tu derecho a audiencias"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HUWAG kailanman pumirma ng kusang pag-alis - mawawala ang karapatan mo sa mga pagdinig"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne signez JAMAIS un départ volontaire - vous perdez votre droit aux audiences"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वैच्छिक प्रस्थान पर कभी हस्ताक्षर न करें - आप सुनवाई का अधिकार खो देंगे"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PA JANM siyen depa volontè - ou pèdi dwa ou pou odyans"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절대 자진 출국에 서명하지 마세요 - 청문회 권리를 잃습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NUNCA assine saída voluntária - você perde seu direito a audiências"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "НИКОГДА не подписывайте добровольный выезд - вы потеряете право на слушания"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KHÔNG BAO GIỜ ký tự nguyện rời đi - bạn mất quyền được điều trần"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不要签署自愿离境 - 您将失去听证会的权利"
          }
        }
      }
    },
