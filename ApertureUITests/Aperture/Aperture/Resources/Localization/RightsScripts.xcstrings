        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ICE प्रशासनिक वारंट - घर में प्रवेश की अनुमति नहीं देता"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MANDA ADMINISTRATIF ICE - PA otorize antre lakay"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ICE 행정 영장 - 가정 입장을 허용하지 않음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MANDADO ADMINISTRATIVO DO ICE - NÃO autoriza entrada na casa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "АДМИНИСТРАТИВНЫЙ ОРДЕР ICE - НЕ разрешает вход в дом"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LỆNH HÀNH CHÍNH ICE - KHÔNG cho phép vào nhà"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ICE行政令状 - 不授权进入住所"
