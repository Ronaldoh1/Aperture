    "rights.script.attorney" : {
      "comment" : "CRITICAL - Request attorney",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أريد التحدث إلى محامٍ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I want to speak to an attorney."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiero hablar con un abogado."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusto kong makipag-usap sa isang abogado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
