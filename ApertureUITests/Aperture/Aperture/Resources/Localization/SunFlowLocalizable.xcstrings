    "rights.disclaimer" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه معلومات تعليمية وليست استشارة قانونية. للحالات المحددة، استشر محامياً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is educational information, NOT legal advice. For specific situations, consult an attorney."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es información educativa, NO asesoría legal. Para situaciones específicas, consulte a un abogado."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ito ay pang-edukasyong impormasyon, HINDI legal na payo. Para sa mga partikular na sitwasyon, kumonsulta sa abogado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est une information éducative, PAS un conseil juridique. Pour des situations spécifiques, consultez un avocat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह शैक्षिक जानकारी है, कानूनी सलाह नहीं। विशिष्ट स्थितियों के लिए, वकील से परामर्श करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa se enfòmasyon edikasyon, PA konsèy legal. Pou sitiyasyon espesifik, konsilte yon avoka."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 교육 정보이며 법적 조언이 아닙니다. 특정 상황에 대해서는 변호사와 상담하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é uma informação educacional, NÃO aconselhamento jurídico. Para situações específicas, consulte um advogado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это образовательная информация, а НЕ юридическая консультация. По конкретным ситуациям обращайтесь к адвокату."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là thông tin giáo dục, KHÔNG phải tư vấn pháp lý. Đối với các tình huống cụ thể, hãy tham khảo luật sư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是教育信息，不是法律建议。具体情况请咨询律师。"
          }
        }
      }
    },
