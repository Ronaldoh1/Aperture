# ═══════════════════════════════════════════════════════════════════════════════
# APERTURE - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.default .env
#
# NEVER commit .env to git! It contains secrets.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# APPLE DEVELOPER
# ─────────────────────────────────────────────────────────────────────────────────

# Your Apple ID email
APPLE_ID=your-apple-id@email.com

# Your Apple Developer Team ID
# Find at: https://developer.apple.com/account → Membership → Team ID
TEAM_ID=XXXXXXXXXX

# App Store Connect Team ID (usually same as TEAM_ID)
ITC_TEAM_ID=XXXXXXXXXX

# App-Specific Password (for CI/automation)
# Generate at: https://appleid.apple.com → Security → App-Specific Passwords
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─────────────────────────────────────────────────────────────────────────────────
# FIREBASE
# ─────────────────────────────────────────────────────────────────────────────────

# Firebase App ID (iOS)
# Find at: Firebase Console → Project Settings → Your apps → App ID
FIREBASE_APP_ID=1:123456789:ios:abcdef123456

# Firebase CLI Token (for CI)
# Generate with: firebase login:ci
FIREBASE_CLI_TOKEN=your-firebase-ci-token

# ─────────────────────────────────────────────────────────────────────────────────
# MATCH (CODE SIGNING)
# ─────────────────────────────────────────────────────────────────────────────────

# Git URL for certificates repository
MATCH_GIT_URL=https://github.com/yourusername/ios-certificates.git

# Password to encrypt/decrypt certificates
MATCH_PASSWORD=your-secure-password

# For GitHub, use a Personal Access Token
MATCH_GIT_BASIC_AUTHORIZATION=base64_encoded_username:token

# ─────────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────

# Bundle identifier
APP_IDENTIFIER=com.sunflow.aperture

# ─────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: SLACK NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────────────────────

# Slack webhook URL for build notifications
# SLACK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ─────────────────────────────────────────────────────────────────────────────────
# CI ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────────

# Set to 1 in CI environments
# CI=1

# Keychain for CI
# MATCH_KEYCHAIN_NAME=fastlane_keychain
# MATCH_KEYCHAIN_PASSWORD=keychain_password
