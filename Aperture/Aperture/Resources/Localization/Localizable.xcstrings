        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thank you for the offer for the %1$@ position. I'm excited about the opportunity to join %2$@.\n\nAfter researching market rates for this role in %3$@ and considering my experience, I'd like to discuss a base salary of $%4$@.\n\nI'm confident I can bring significant value to the team and am looking forward to discussing this further."
          }
