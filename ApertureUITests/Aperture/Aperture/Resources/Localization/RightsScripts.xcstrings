    "rights.script.detained" : {
      "comment" : "CRITICAL - Ask if free to go",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنا محتجز أم أنني حر في الذهاب؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am I being detained or am I free to go?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estoy detenido o soy libre de irme?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinedetine ba ako o malaya na akong umalis?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suis-je détenu ou suis-je libre de partir?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या मुझे हिरासत में लिया गया है या मैं जाने के लिए स्वतंत्र हूं?"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Èske yo arete m oswa mwen lib pou m ale?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 구금된 것입니까, 아니면 가도 됩니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estou sendo detido ou estou livre para ir?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я задержан или могу идти?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi đang bị giam giữ hay tôi được tự do đi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是被拘留还是可以自由离开？"
          }
        }
      }
    },
    "rights.script.ice.notjudicial" : {
      "comment" : "CRITICAL - ICE warrant is not judicial",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا ليس أمراً قضائياً. أنا لا أوافق على الدخول."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a judicial warrant. I do not consent to entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta no es una orden judicial. No consiento a la entrada."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ito ay hindi hudisyal na warrant. Hindi ako pumapayag sa pagpasok."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas un mandat judiciaire. Je ne consens pas à l'entrée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह न्यायिक वारंट नहीं है। मैं प्रवेश की सहमति नहीं देता।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa se pa yon manda jidisyè. Mwen pa dakò pou yo antre."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 사법 영장이 아닙니다. 저는 입장에 동의하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este não é um mandado judicial. Eu não consinto com a entrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не судебный ордер. Я не даю согласия на вход."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây không phải là lệnh của tòa án. Tôi không đồng ý cho vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是司法令状。我不同意进入。"
          }
        }
      }
    },
    "rights.script.noentry" : {
      "comment" : "CRITICAL - Refuse entry to home",
      "extractionState" : "stale",
      "localizations" : {
