# ═══════════════════════════════════════════════════════════════════════════
# APERTURE - Fastlane Configuration v2.0
# Complete CI/CD: Device builds, TestFlight, Firebase, Static Analysis
# ═══════════════════════════════════════════════════════════════════════════
#
# QUICK REFERENCE:
#   fastlane device          - Build & run on connected device (no tests)
#   fastlane simulator       - Build for simulator (no tests)
#   fastlane adhoc           - Ad-hoc IPA for sharing
#   fastlane beta            - TestFlight deployment
#   fastlane firebase        - Firebase App Distribution
#   fastlane analyze         - Static code analysis
#   fastlane lint_spanish    - Check Spanish localization
#   fastlane security_audit  - Security check
#   fastlane test            - Run ALL tests
#   fastlane test_unit       - Unit tests only
#   fastlane test_ui         - UI tests only
#
# ═══════════════════════════════════════════════════════════════════════════

default_platform(:ios)

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

APP_IDENTIFIER = ENV["APP_IDENTIFIER"] || "com.sunflow.aperture"
SCHEME = ENV["SCHEME"] || "Aperture"
PROJECT = "Aperture.xcodeproj"

# Firebase Configuration
FIREBASE_APP_ID = ENV["FIREBASE_APP_ID"] || "1:YOUR_PROJECT_ID:ios:YOUR_APP_ID"
FIREBASE_TESTERS_FILE = "fastlane/testers.txt"
FIREBASE_GROUPS = "aperture-testers"

# Build outputs
OUTPUT_DIR = "./build"

# ─────────────────────────────────────────────────────────────────────────────
# HELPER: Verbose logging
# ─────────────────────────────────────────────────────────────────────────────

def log_verbose(message)
  UI.message("🔍 [VERBOSE] #{message}")
end

def log_step(step_name)
  UI.header("═" * 60)
  UI.header("📍 #{step_name}")
  UI.header("═" * 60)
end

# ─────────────────────────────────────────────────────────────────────────────
# iOS LANES
# ─────────────────────────────────────────────────────────────────────────────

platform :ios do

  # ═══════════════════════════════════════════════════════════════════════════
  # BEFORE ALL - Setup
  # ═══════════════════════════════════════════════════════════════════════════
  
  before_all do |lane|
    log_verbose("Starting lane: #{lane}")
    log_verbose("Project: #{PROJECT}")
    log_verbose("Scheme: #{SCHEME}")
    log_verbose("Bundle ID: #{APP_IDENTIFIER}")
    log_verbose("Time: #{Time.now}")
    
    # Ensure output directory exists
    FileUtils.mkdir_p(OUTPUT_DIR)
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # BUILD - No signing, just verify compilation
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🔨 Build only (no signing, no tests) - Fastest verification"
  lane :build do
    log_step("Building Aperture (No Signing)")
    
    xcodebuild(
      scheme: SCHEME,
      project: PROJECT,
      destination: "generic/platform=iOS Simulator",
      xcargs: "-configuration Debug CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation"
    )
    
    UI.success("✅ Build successful!")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # DEVICE - Build and run on connected device (NO TESTS)
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "📱 Build and install on connected device (NO tests)"
  lane :device do |options|
    log_step("Building for Connected Device")
    
    log_verbose("Detecting connected devices...")
    
    # Build for device with development signing
    gym(
      scheme: SCHEME,
      project: PROJECT,
      configuration: "Debug",
      export_method: "development",
      output_directory: OUTPUT_DIR,
      output_name: "Aperture-Device.ipa",
      clean: options[:clean] || false,
      include_bitcode: false,
      include_symbols: true,
      silent: false,
      xcargs: "-allowProvisioningUpdates"
    )
    
    UI.success("=" * 60)
    UI.success("📱 Device build complete!")
    UI.success("=" * 60)
    UI.message("IPA: #{OUTPUT_DIR}/Aperture-Device.ipa")
    UI.message("")
    UI.message("To install manually:")
    UI.message("  1. Open Finder → Your iPhone")
    UI.message("  2. Drag IPA to the app list")
    UI.message("  OR use: ios-deploy --bundle #{OUTPUT_DIR}/Aperture-Device.ipa")
  end
  
  desc "📱 Build for device with CLEAN build"
  lane :device_clean do
    device(clean: true)
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # SIMULATOR - Build and run on simulator (NO TESTS)
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🖥️ Build for simulator (NO tests)"
  lane :simulator do |options|
    log_step("Building for Simulator")
    
    device_name = options[:device] || "iPhone 15 Pro"
    log_verbose("Target simulator: #{device_name}")
    
    xcodebuild(
      scheme: SCHEME,
      project: PROJECT,
      destination: "platform=iOS Simulator,name=#{device_name}",
      xcargs: "-configuration Debug CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation"
    )
    
    UI.success("🖥️ Simulator build complete!")
    UI.message("Run in Xcode or: open -a Simulator")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # TESTS - Various test configurations
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🧪 Run ALL tests (unit + UI)"
  lane :test do |options|
    log_step("Running All Tests")
    
    scan(
      scheme: SCHEME,
      project: PROJECT,
      devices: [options[:device] || "iPhone 15 Pro"],
      clean: options[:clean] || false,
      code_coverage: true,
      output_directory: "#{OUTPUT_DIR}/test_output",
      output_types: "html,junit",
      xcargs: "-skipPackagePluginValidation"
    )
    
    UI.success("🧪 All tests passed!")
  end
  
  desc "🧪 Run UNIT tests only (fast)"
  lane :test_unit do |options|
    log_step("Running Unit Tests Only")
    
    scan(
      scheme: SCHEME,
      project: PROJECT,
      devices: [options[:device] || "iPhone 15 Pro"],
      only_testing: ["ApertureTests"],
      code_coverage: true,
      output_directory: "#{OUTPUT_DIR}/test_output",
      xcargs: "-skipPackagePluginValidation"
    )
    
    UI.success("🧪 Unit tests passed!")
  end
  
  desc "🧪 Run UI/Integration tests only"
  lane :test_ui do |options|
    log_step("Running UI Tests Only")
    
    scan(
      scheme: SCHEME,
      project: PROJECT,
      devices: [options[:device] || "iPhone 15 Pro"],
      only_testing: ["ApertureUITests"],
      code_coverage: false,
      output_directory: "#{OUTPUT_DIR}/test_output",
      xcargs: "-skipPackagePluginValidation"
    )
    
    UI.success("🧪 UI tests passed!")
  end
  
  desc "🧪 Skip ALL tests - just verify build"
  lane :no_tests do
    build
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # AD-HOC - Build for direct distribution
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "📦 Build ad-hoc IPA (verbose)"
  lane :adhoc do |options|
    log_step("Building Ad-Hoc IPA")
    
    # Increment build number
    build_num = Time.now.strftime("%Y%m%d.%H%M")
    log_verbose("Setting build number: #{build_num}")
    increment_build_number(build_number: build_num)
    
    log_verbose("Starting archive...")
    
    gym(
      scheme: SCHEME,
      project: PROJECT,
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: OUTPUT_DIR,
      output_name: "Aperture-AdHoc.ipa",
      clean: options[:clean] || false,
      silent: false,
      include_bitcode: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates"
    )
    
    ipa_path = File.expand_path("#{OUTPUT_DIR}/Aperture-AdHoc.ipa")
    ipa_size = (File.size(ipa_path) / 1024.0 / 1024.0).round(2) rescue "?"
    
    UI.success("=" * 60)
    UI.success("📦 Ad-hoc IPA ready!")
    UI.success("=" * 60)
    UI.message("Location: #{ipa_path}")
    UI.message("Size: #{ipa_size} MB")
    UI.message("")
    UI.message("Share via:")
    UI.message("  • AirDrop to registered devices")
    UI.message("  • Upload to Firebase: fastlane firebase_upload")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # TESTFLIGHT BETA
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🚀 Deploy to TestFlight (verbose)"
  lane :beta do |options|
    log_step("Deploying to TestFlight")
    
    # Increment build number
    build_num = Time.now.strftime("%Y%m%d.%H%M")
    log_verbose("Build number: #{build_num}")
    increment_build_number(build_number: build_num)
    
    log_verbose("Building for App Store distribution...")
    
    gym(
      scheme: SCHEME,
      project: PROJECT,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "Aperture-AppStore.ipa",
      clean: false,
      silent: false,
      include_bitcode: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates"
    )
    
    # Upload to TestFlight
    changelog = options[:changelog] || generate_changelog
    log_verbose("Changelog: #{changelog}")
    
    log_verbose("Uploading to TestFlight...")
    
    pilot(
      skip_waiting_for_build_processing: true,
      changelog: changelog,
      distribute_external: false,
      notify_external_testers: false
    )
    
    UI.success("=" * 60)
    UI.success("🎉 TestFlight upload complete!")
    UI.success("=" * 60)
    UI.message("Build will be available in ~15-30 minutes")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # FIREBASE APP DISTRIBUTION
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🔥 Deploy to Firebase App Distribution (verbose)"
  lane :firebase do |options|
    log_step("Deploying to Firebase App Distribution")
    
    # Increment build number
    build_num = Time.now.strftime("%Y%m%d.%H%M")
    log_verbose("Build number: #{build_num}")
    increment_build_number(build_number: build_num)
    
    log_verbose("Building ad-hoc for Firebase...")
    
    gym(
      scheme: SCHEME,
      project: PROJECT,
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: OUTPUT_DIR,
      output_name: "Aperture-Firebase.ipa",
      silent: false,
      include_bitcode: false,
      xcargs: "-allowProvisioningUpdates"
    )
    
    # Release notes
    release_notes = options[:notes] || generate_changelog
    log_verbose("Release notes: #{release_notes}")
    
    # Check for Firebase token
    unless ENV["FIREBASE_CLI_TOKEN"]
      UI.important("⚠️  FIREBASE_CLI_TOKEN not set!")
      UI.message("Run: firebase login:ci")
      UI.message("Then: export FIREBASE_CLI_TOKEN='your_token'")
      UI.user_error!("Missing Firebase token")
    end
    
    log_verbose("Uploading to Firebase...")
    log_verbose("App ID: #{FIREBASE_APP_ID}")
    log_verbose("Groups: #{FIREBASE_GROUPS}")
    
    firebase_app_distribution(
      app: FIREBASE_APP_ID,
      ipa_path: "#{OUTPUT_DIR}/Aperture-Firebase.ipa",
      release_notes: release_notes,
      groups: FIREBASE_GROUPS,
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      debug: true
    )
    
    UI.success("=" * 60)
    UI.success("🔥 Firebase distribution complete!")
    UI.success("=" * 60)
    UI.message("Testers will receive notification shortly")
  end
  
  desc "🔥 Upload existing IPA to Firebase"
  lane :firebase_upload do |options|
    log_step("Uploading to Firebase")
    
    ipa_path = options[:ipa] || "#{OUTPUT_DIR}/Aperture-AdHoc.ipa"
    
    unless File.exist?(ipa_path)
      UI.user_error!("IPA not found at: #{ipa_path}")
    end
    
    release_notes = options[:notes] || "Manual upload - #{Time.now.strftime('%B %d, %Y')}"
    
    firebase_app_distribution(
      app: FIREBASE_APP_ID,
      ipa_path: ipa_path,
      release_notes: release_notes,
      groups: FIREBASE_GROUPS,
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      debug: true
    )
    
    UI.success("🔥 Firebase upload complete!")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # DEPLOY TO BOTH PLATFORMS
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🚀🔥 Deploy to BOTH TestFlight AND Firebase"
  lane :beta_all do |options|
    log_step("Deploying to TestFlight + Firebase")
    
    changelog = options[:changelog] || generate_changelog
    
    build_num = Time.now.strftime("%Y%m%d.%H%M")
    increment_build_number(build_number: build_num)
    
    # 1. TestFlight
    UI.message("📱 Step 1/4: Building for TestFlight...")
    gym(
      scheme: SCHEME,
      project: PROJECT,
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "Aperture-AppStore.ipa",
      xcargs: "-allowProvisioningUpdates"
    )
    
    UI.message("📤 Step 2/4: Uploading to TestFlight...")
    pilot(
      skip_waiting_for_build_processing: true,
      changelog: changelog,
      distribute_external: false
    )
    
    # 2. Firebase
    UI.message("🔨 Step 3/4: Building for Firebase...")
    gym(
      scheme: SCHEME,
      project: PROJECT,
      export_method: "ad-hoc",
      output_directory: OUTPUT_DIR,
      output_name: "Aperture-Firebase.ipa",
      xcargs: "-allowProvisioningUpdates"
    )
    
    UI.message("🔥 Step 4/4: Uploading to Firebase...")
    firebase_app_distribution(
      app: FIREBASE_APP_ID,
      ipa_path: "#{OUTPUT_DIR}/Aperture-Firebase.ipa",
      release_notes: changelog,
      groups: FIREBASE_GROUPS,
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"]
    )
    
    UI.success("=" * 60)
    UI.success("🎉 Deployed to BOTH platforms!")
    UI.success("=" * 60)
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # STATIC ANALYSIS & LINTING
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🔍 Run static code analysis (SwiftLint + Xcode Analyzer)"
  lane :analyze do
    log_step("Running Static Analysis")
    
    issues_found = []
    
    # 1. SwiftLint
    log_verbose("Running SwiftLint...")
    begin
      swiftlint(
        mode: :lint,
        config_file: ".swiftlint.yml",
        raise_if_swiftlint_error: false,
        ignore_exit_status: true
      )
    rescue => e
      log_verbose("SwiftLint: #{e.message}")
    end
    
    # 2. Xcode Static Analyzer
    log_verbose("Running Xcode Static Analyzer...")
    
    xcodebuild(
      scheme: SCHEME,
      project: PROJECT,
      destination: "generic/platform=iOS Simulator",
      xcargs: "-configuration Debug analyze CODE_SIGNING_ALLOWED=NO CLANG_STATIC_ANALYZER_MODE=deep RUN_CLANG_STATIC_ANALYZER=YES 2>&1 | tee #{OUTPUT_DIR}/analyze.log"
    )
    
    # Parse results
    if File.exist?("#{OUTPUT_DIR}/analyze.log")
      log_content = File.read("#{OUTPUT_DIR}/analyze.log")
      warnings = log_content.scan(/warning:/).count
      errors = log_content.scan(/error:/).count
      
      UI.success("=" * 60)
      UI.success("🔍 Static Analysis Complete")
      UI.success("=" * 60)
      UI.message("Warnings: #{warnings}")
      UI.message("Errors: #{errors}")
      UI.message("Full log: #{OUTPUT_DIR}/analyze.log")
    end
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # LOCALIZATION CHECK
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🌍 Check Spanish localization completeness"
  lane :lint_spanish do
    log_step("Checking Spanish Localization")
    
    # Find xcstrings file
    xcstrings_files = Dir.glob("**/*.xcstrings").reject { |f| f.include?("Pods") }
    
    if xcstrings_files.empty?
      UI.error("No .xcstrings files found!")
      next
    end
    
    total_missing = []
    
    xcstrings_files.each do |xcstrings_file|
      UI.message("Checking: #{xcstrings_file}")
      
      begin
        content = JSON.parse(File.read(xcstrings_file))
        strings = content["strings"] || {}
        
        missing_spanish = []
        total = 0
        translated = 0
        
        strings.each do |key, value|
          total += 1
          localizations = value["localizations"] || {}
          
          if localizations["es"]
            spanish = localizations["es"]["stringUnit"]
            if spanish && spanish["value"] && !spanish["value"].empty?
              translated += 1
            else
              missing_spanish << key
            end
          else
            missing_spanish << key
          end
        end
        
        percentage = total > 0 ? ((translated.to_f / total) * 100).round(1) : 0
        
        UI.message("  Total: #{total}, Translated: #{translated} (#{percentage}%)")
        
        if missing_spanish.any?
          total_missing.concat(missing_spanish)
        end
      rescue JSON::ParserError => e
        UI.error("Failed to parse #{xcstrings_file}: #{e.message}")
      end
    end
    
    UI.success("=" * 60)
    UI.success("🌍 Spanish Localization Report")
    UI.success("=" * 60)
    
    if total_missing.any?
      UI.important("Missing #{total_missing.count} Spanish translations:")
      total_missing.first(20).each { |key| UI.message("  • #{key}") }
      if total_missing.count > 20
        UI.message("  ... and #{total_missing.count - 20} more")
      end
      
      File.write("#{OUTPUT_DIR}/missing_spanish.txt", total_missing.join("\n"))
      UI.message("\nFull list: #{OUTPUT_DIR}/missing_spanish.txt")
    else
      UI.success("✅ All strings translated to Spanish!")
    end
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # SECURITY AUDIT
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🔐 Run security audit"
  lane :security_audit do
    log_step("Running Security Audit")
    
    issues = []
    
    swift_files = Dir.glob("**/*.swift").reject { |f| f.include?("Pods") || f.include?(".build") || f.include?("Tests") }
    
    UI.message("Scanning #{swift_files.count} Swift files...")
    
    # 1. Check for hardcoded secrets
    log_verbose("Checking for hardcoded secrets...")
    
    secret_patterns = {
      "API Key" => /["'][\w-]{20,}["']/,
      "Bearer Token" => /Bearer\s+[\w-]+/,
      "Password literal" => /password\s*[:=]\s*["'][^"']+["']/i,
      "Secret literal" => /secret\s*[:=]\s*["'][^"']+["']/i,
      "Private key" => /-----BEGIN.*PRIVATE KEY-----/
    }
    
    swift_files.each do |file|
      content = File.read(file) rescue next
      
      secret_patterns.each do |name, pattern|
        if content.match?(pattern)
          issues << "⚠️  Potential #{name} in #{file}"
        end
      end
    end
    
    # 2. Check Info.plist
    log_verbose("Checking Info.plist...")
    
    Dir.glob("**/Info.plist").each do |plist|
      content = File.read(plist) rescue next
      
      if content.include?("NSAllowsArbitraryLoads") && content.include?("<true/>")
        issues << "⚠️  App Transport Security disabled in #{plist}"
      end
      
      if content.include?("NSCameraUsageDescription").! && content.include?("camera")
        issues << "⚠️  Missing camera usage description"
      end
    end
    
    # 3. Check for insecure storage
    log_verbose("Checking for insecure storage patterns...")
    
    swift_files.each do |file|
      content = File.read(file) rescue next
      
      if content.include?("UserDefaults") && (content.match?(/password/i) || content.match?(/token/i) || content.match?(/secret/i))
        issues << "⚠️  Sensitive data in UserDefaults? Check #{file}"
      end
      
      if content.match?(/print\(.*password/i) || content.match?(/print\(.*token/i)
        issues << "⚠️  Possible sensitive data logging in #{file}"
      end
    end
    
    # 4. Check for SSL pinning
    log_verbose("Checking for SSL pinning...")
    has_ssl_pinning = swift_files.any? do |file|
      content = File.read(file) rescue ""
      content.include?("URLAuthenticationChallenge") || content.include?("pinnedCertificates")
    end
    
    unless has_ssl_pinning
      issues << "ℹ️  No SSL certificate pinning detected (optional but recommended)"
    end
    
    UI.success("=" * 60)
    UI.success("🔐 Security Audit Complete")
    UI.success("=" * 60)
    
    if issues.any?
      UI.important("Found #{issues.count} items to review:")
      issues.each { |issue| UI.message(issue) }
      
      File.write("#{OUTPUT_DIR}/security_audit.txt", issues.join("\n"))
      UI.message("\nReport saved: #{OUTPUT_DIR}/security_audit.txt")
    else
      UI.success("✅ No obvious security issues found!")
    end
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # PERSISTENCE CHECK
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "💾 Check persistence implementation"
  lane :check_persistence do
    log_step("Checking Persistence Implementation")
    
    swift_files = Dir.glob("**/*.swift").reject { |f| f.include?("Pods") || f.include?(".build") }
    
    persistence_types = {
      "UserDefaults" => [],
      "CoreData" => [],
      "SwiftData" => [],
      "Keychain" => [],
      "FileManager" => [],
      "@AppStorage" => [],
      "Realm" => [],
      "SQLite" => []
    }
    
    swift_files.each do |file|
      content = File.read(file) rescue next
      
      persistence_types.each do |type, files|
        if content.include?(type)
          files << file
        end
      end
    end
    
    UI.success("=" * 60)
    UI.success("💾 Persistence Implementation Report")
    UI.success("=" * 60)
    
    persistence_types.each do |type, files|
      if files.any?
        UI.message("")
        UI.message("#{type}: #{files.count} files")
        files.first(5).each { |f| UI.message("  • #{f}") }
        UI.message("  ... and #{files.count - 5} more") if files.count > 5
      end
    end
    
    # Check for potential issues
    UI.message("")
    UI.message("Recommendations:")
    
    if persistence_types["UserDefaults"].any? && persistence_types["Keychain"].empty?
      UI.important("⚠️  Using UserDefaults but no Keychain - store sensitive data in Keychain")
    end
    
    if persistence_types["CoreData"].any? || persistence_types["SwiftData"].any?
      UI.message("✅ Using structured persistence (CoreData/SwiftData)")
    end
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # CERTIFICATES & PROFILES
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🔐 Sync all certificates and profiles"
  lane :certs do
    log_step("Syncing Certificates")
    
    match(type: "development", app_identifier: APP_IDENTIFIER, readonly: is_ci)
    match(type: "adhoc", app_identifier: APP_IDENTIFIER, readonly: is_ci)
    match(type: "appstore", app_identifier: APP_IDENTIFIER, readonly: is_ci)
    
    UI.success("🔐 Certificates synced!")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # DEVICE REGISTRATION
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "📱 Register a new device for testing"
  lane :register_device do
    device_name = UI.input("Device name (e.g., Ron's iPhone):")
    device_udid = UI.input("Device UDID:")
    
    register_devices(devices: { device_name => device_udid })
    
    match(type: "development", force_for_new_devices: true)
    match(type: "adhoc", force_for_new_devices: true)
    
    UI.success("📱 Device registered!")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # APP STORE RELEASE
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🏆 Submit to App Store"
  lane :release do |options|
    log_step("Submitting to App Store")
    
    version = options[:version]
    unless version
      current = get_version_number(target: "Aperture") rescue "1.0.0"
      version = UI.input("Enter version number (current: #{current}):")
    end
    
    increment_version_number(version_number: version)
    increment_build_number(build_number: "1")
    
    gym(
      scheme: SCHEME,
      project: PROJECT,
      export_method: "app-store",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )
    
    deliver(
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false
    )
    
    git_commit(path: ".", message: "Release v#{version}") rescue nil
    add_git_tag(tag: "v#{version}") rescue nil
    
    UI.success("🏆 Version #{version} uploaded!")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # FULL AUDIT
  # ═══════════════════════════════════════════════════════════════════════════
  
  desc "🔬 Full code audit (analyze + security + localization + persistence)"
  lane :full_audit do
    analyze
    security_audit
    lint_spanish
    check_persistence
    
    UI.success("=" * 60)
    UI.success("🔬 Full Audit Complete!")
    UI.success("=" * 60)
    UI.message("Check #{OUTPUT_DIR}/ for detailed reports")
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # HELPER METHODS
  # ═══════════════════════════════════════════════════════════════════════════
  
  def generate_changelog
    changelog = changelog_from_git_commits(
      commits_count: 10,
      pretty: "- %s",
      date_format: "short",
      merge_commit_filtering: "exclude_merges"
    ) rescue "New build with latest features and fixes"
    
    build_time = Time.now.strftime("%B %d, %Y at %I:%M %p")
    "Build: #{build_time}\n\nChanges:\n#{changelog}"
  end

  # ═══════════════════════════════════════════════════════════════════════════
  # ERROR HANDLING
  # ═══════════════════════════════════════════════════════════════════════════
  
  error do |lane, exception|
    UI.error("=" * 60)
    UI.error("❌ #{lane} failed!")
    UI.error("=" * 60)
    UI.error(exception.message)
    UI.error("")
    UI.error("Backtrace (first 10 lines):")
    exception.backtrace.first(10).each { |line| UI.error("  #{line}") }
  end
  
  after_all do |lane|
    log_verbose("Lane #{lane} completed successfully ✅")
  end

end
